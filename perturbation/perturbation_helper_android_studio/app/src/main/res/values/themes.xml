<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Theme.PerturbationHelper" parent="Theme.Material3.Light.NoActionBar">
    <item name="colorPrimary">@color/popup_accent</item>
    <item name="colorSurface">@color/surface_primary</item>
    <item name="android:statusBarColor">@color/background_subtle</item>
    <item name="android:navigationBarColor">@color/background_subtle</item>
  </style>

  <style name="Theme.PerturbationHelper.Interruption" parent="Theme.Material3.Light.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <style name="Widget.PerturbationHelper.PrimaryButton" parent="Widget.Material3.Button">
    <item name="android:textColor">@color/white</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
  </style>

  <style name="Widget.PerturbationHelper.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
  </style>
</resources>
